# Copy to .env and fill in. .env is git-ignored; this file is not.

# GCN client credentials -- create at https://gcn.nasa.gov/quickstart
GCN_CLIENT_ID=
GCN_CLIENT_SECRET=

# Elasticsearch / Kibana. es01 runs with security on: HTTPS + basic auth.
# Use http://localhost:9201 and http://localhost:5602 for the compose stack instead.
ES_URL=https://localhost:9200
KIBANA_URL=http://localhost:5601
ES_USER=elastic
ES_PASSWORD=

# CA copied out of the container so TLS is verified (see README):
#   docker exec es01 cat /usr/share/elasticsearch/config/certs/http_ca.crt > certs/es01_ca.crt
# Leave empty when ES_URL is plain http.
ES_CA_CERT=certs/es01_ca.crt
